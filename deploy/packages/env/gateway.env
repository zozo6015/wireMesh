# WireMesh gateway configuration (systemd EnvironmentFile).
# The gateway is argv-configured; put its flags in GATEWAY_ARGS.
#
# BEFORE first start, enroll once to create the on-disk identity (needs a token
# minted by the controller/operator):
#   wiremesh-gateway enroll --token-file /etc/wiremesh/gateway.token \
#     --controller <controller-host:9400> --ca /etc/wiremesh/ca.pem \
#     --state-dir /var/lib/wiremesh --cidr <this-segment-cidr>
#
# Then set the runtime flags (point at the controller's sync + observe ports).
# CONTROLLER_HOST may be a DNS hostname (e.g. a DDNS name for a controller
# behind a dynamic public IP) or an IPv4 literal; the gateway re-resolves the
# name on every Sync reconnect and observe tick, so a rotated dynamic IP is
# picked up automatically without a restart.
GATEWAY_ARGS=--controller-sync CONTROLLER_HOST:9500 --observe CONTROLLER_HOST:9600 --tun wg0 --wg-port 51820 --state-dir /var/lib/wiremesh
