target/
.DS_Store

# graphify knowledge graph (docs/research/… is the source of truth; this is derived)
# Tracked deliberately: cache/semantic (cost ~718K LLM tokens to rebuild) and
# manifest.json (drives incremental --update). Everything else is regenerable —
# AST extraction is deterministic and free, graph.json/html/report derive from cache.
graphify-out/*
!graphify-out/cache/
graphify-out/cache/*
!graphify-out/cache/semantic/
!graphify-out/manifest.json

# Claude Code local state — none of it is shareable as-is:
#   settings.json        hooks with absolute machine-specific paths
#   settings.local.json  personal permission grants (home-dir paths)
#   worktrees/           transient full-repo checkouts created per task
# Nothing under .claude/ has ever been tracked; this makes that explicit so a
# stray `git add -A` cannot commit a repo copy into the repo.
.claude/
