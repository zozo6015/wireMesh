{"nodes": [{"id": "docs_research_phase0_report_phase0_go_no_go_report", "label": "Phase 0 Spike Report \u2014 go/no-go per bet", "file_type": "document", "source_file": "docs/research/phase0-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Phase 0 spike (Task 15 synthesis)", "contributor": null}, {"id": "docs_research_phase0_report_bet1_boringtun_embed", "label": "Bet 1 \u2014 boringtun embed + throughput (go-with-caveats)", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Embedding is unconditionally proven; the throughput claim is explicitly unresolved and gated on the G-2 cloud run. Adopt boringtun as-is, do not fork, do not escalate to a kernel-only spec change \u2014 conditional on that run."}, {"id": "docs_research_phase0_report_bet2_tc_bpf_enforcer", "label": "Bet 2 \u2014 tc-BPF stateful ACL on tun (go)", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": "spike/enforcer/enforcer/tests/enforce.rs", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_phase0_report_bet3_quic_relay", "label": "Bet 3 \u2014 QUIC datagram relay + WG-over-relay (go)", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": "spike/relay/tests/wg_over_relay.rs", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_phase0_report_bet4_observation_and_punch", "label": "Bet 4 \u2014 UDP observation + brokered punch (go)", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": "spike/punch/tests/punch.rs", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_phase0_report_bet5_nat_matrix_harness", "label": "Bet 5 \u2014 NAT matrix harness natlab (go)", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": "spike/natlab/tests/nat_behavior.rs", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_phase0_report_icmp_echo_reverse_key_asymmetry", "label": "ICMP-ECHO reverse-flow key asymmetry", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Egress records echo as {sport: id, dport: 0} while the ingress reverse lookup swaps to {sport: 0, dport: id}, so inside-initiated echo replies never match the flow table. ICMP errors are unaffected \u2014 a disjoint type set independent of the echo encoding."}, {"id": "docs_research_phase0_report_self_punch_bug", "label": "Self-punch bug \u2014 sendto() to 0.0.0.0 rewritten to 127.0.0.1", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": "spike/punch/src/puncher.rs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every puncher PINGed itself over loopback and instantly self-punched, masking the real outcome and making even the symmetric cell spuriously succeed; fixed by registering only the observed post-NAT candidate and skipping unspecified/loopback in the PING loop, with the positive test now asserting the peer's real public address so it cannot regress silently."}, {"id": "docs_research_phase0_report_conntrack_poisoning_go_skew", "label": "Zero-latency conntrack poisoning \u2192 Sync go-skew constraint", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": "spec \u00a76.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unsolicited inbound PING creates an [UNREPLIED] conntrack entry that poisons the masquerade source port for 30s. tc netem delay 20ms per internet-side link restores the real-world invariant \u2014 a modeled-physics fix, not a flakiness mask. Design implication: broker go-skew must stay below the inter-peer one-way latency."}, {"id": "docs_research_phase0_report_boringtun_receive_cap", "label": "boringtun ~7.7 Mbit/s receive-side delivery cap (unexplained)", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed cap independent of protocol, parallelism and offered rate is the signature of a receive-pipeline bottleneck and is inconsistent with shared-vCPU scheduling noise \u2014 but the cause has not been isolated, so it is a hypothesis, not a finding."}, {"id": "docs_research_phase0_report_sighup_default_disposition_bug", "label": "SIGHUP default disposition killed the enforcer (false 0% loss)", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Task-6 scaffold parked with no signal handler, so the first kill -HUP terminated the process and silently detached enforcement \u2014 a near-0%-loss result for the wrong reason. Fixed by installing the handler before the first apply_rules."}, {"id": "docs_research_phase0_report_bpffs_container_quirks", "label": "Docker/container BPF quirks \u2014 bpffs unmounted, mounts don't cross netns", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_phase0_report_uapi_mount_namespace_scoping", "label": "UAPI control socket is mount-namespace-scoped, not netns-scoped", "file_type": "concept", "source_file": "docs/research/phase0-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_researc