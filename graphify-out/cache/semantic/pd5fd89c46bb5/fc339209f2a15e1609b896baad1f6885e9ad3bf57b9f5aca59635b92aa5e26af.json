{"nodes": [{"id": "docs_research_ops_finding_pvc_adoption_migration_bug1_recreate_strategy_422", "label": "Bug 1 \u2014 strategy: Recreate apply 422s over an existing RollingUpdate Deployment", "file_type": "concept", "source_file": "docs/research/ops-finding-pvc-adoption-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A typed rolling_update: None serializes to omitted, not null, so server-side apply leaves the API-server defaulter's block in place and the merged object is invalid. The unit test only asserts the DESIRED spec; only the cluster could catch the apply-over-existing conflict."}, {"id": "docs_research_ops_finding_pvc_adoption_migration_bug2_adoption_stale_drain", "label": "Bug 2 \u2014 adoption does not drain the old active gateway; enroll rejected", "file_type": "concept", "source_file": "docs/research/ops-finding-pvc-adoption-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "identity_persisted = pvc_exists AND gateway_active is true during adoption, so no fresh token is minted either and the pod stalls in Init:Error. The v0.2.2 fix drains only on the fresh-PVC path and only when the CR is the sole WiremeshGateway for the segment, failing safe to 'not sole'."}, {"id": "docs_research_ops_finding_pvc_adoption_migration_pvc_backed_identity", "label": "PVC-backed gateway identity (v0.2.1)", "file_type": "concept", "source_file": "docs/research/ops-finding-pvc-adoption-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_research_ops_finding_pvc_adoption_migration_bug1_recreate_strategy_422", "target": "docs_research_ops_finding_pvc_adoption_migration_pvc_backed_identity", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/ops-finding-