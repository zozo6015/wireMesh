{"nodes": [{"id": "docs_research_keyrot_task6_uapi_pubkey_note_own_public_key_divergence", "label": "boringtun emits non-standard own_public_key instead of private_key on get=1", "file_type": "concept", "source_file": "docs/research/keyrot-task6-uapi-pubkey-note.md", "source_location": "boringtun-0.6.0/src/device/api.rs::api_get", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The xplatform UAPI has no 'public key of self' field by design \u2014 wg derives it from private_key. boringtun withholds the private key (private-key-exfiltration hardening) and emits a field name wg has never heard of, which its parser silently ignores, so wg show can never display a boringtun device's own public key."}, {"id": "docs_research_keyrot_task6_uapi_pubkey_note_tunnelset_bring_up", "label": "TunnelSet::bring_up applies device identity via one uapi::apply", "file_type": "code", "source_file": "docs/research/keyrot-task6-uapi-pubkey-note.md", "source_location": "crates/wiremesh-gateway/src/tunnelset.rs", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_research_keyrot_task6_uapi_pubkey_note_own_public_key_divergence", "target": "docs_research_keyrot_task6_uapi_pubkey_note_tunnelset_bring_up", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/keyrot-task6-uapi-pubkey-note.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_keyrot_task6_uapi_pubkey_note_own_public_key_divergence", "target": "docs_research_keyrot_spike_note_two_device_mechanism_b", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/keyrot-task6-uapi-pubkey-note.md", "source_location": "spike/keyrot/tests/rotate.rs uses per-peer latest-handshakes instead", "weight": 1.0}, {"source": "docs_research_keyrot_task6_uapi_pubkey_note_own_public_key_divergence", "target": "docs_research