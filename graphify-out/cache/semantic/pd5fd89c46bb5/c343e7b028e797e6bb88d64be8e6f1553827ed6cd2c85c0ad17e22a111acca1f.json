{"nodes": [{"id": "docs_research_keyrot_spike_note_two_device_mechanism_b", "label": "Mechanism B \u2014 two boringtun devices, one overlay via routing", "file_type": "concept", "source_file": "docs/research/keyrot-spike-note.md", "source_location": "spike/keyrot/tests/rotate.rs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both receive paths stay valid for the whole overlap, so the cutover is two independent local route flips with no window in which a sent packet can be rejected \u2014 true zero drop (0/90 packets, three runs), where the single-interface model can at best hit spec C-5's 1-2 packets."}, {"id": "docs_research_keyrot_spike_note_one_private_key_per_interface", "label": "One private key per WireGuard interface", "file_type": "concept", "source_file": "docs/research/keyrot-spike-note.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_keyrot_spike_note_allowed_ips_exclusivity", "label": "allowed-ips are exclusive to one peer per interface", "file_type": "concept", "source_file": "docs/research/keyrot-spike-note.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WireGuard allowed-ips are a partition, not overlapping routes: assigning the overlay /32 to a second peer moves it off the first, and inbound packets on the other key then fail the anti-spoof check \u2014 which is exactly what rules out the spec's 'add the new key as a second peer' mental model."}, {"id": "docs_research_keyrot_spike_note_boringtun_multi_queue_limitation", "label": "boringtun 0.6 opens its tun by name without IFF_MULTI_QUEUE", "file_type": "concept", "source_file": "docs/research/keyrot-spike-note.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_keyrot_spike_note_latest_handshakes_not_wallclock", "label": "boringtun reports latest-handshakes as a small integer, not wall-clock", "file_type": "concept", "source_file": "docs/research/keyrot-spike-note.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session liveness in the real rotation code should be judged by rx_bytes progress, not this field."}], "edges": [{"source": "docs_research_keyrot_spike_note_two_device_mechanism_b", "target": "docs_research_keyrot_spike_note_one_private_key_per_interface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/keyrot-spike-note.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_keyrot_spike_note_two_device_mechanism_b", "target": "docs_research_keyrot_spike_note_allowed_ips_exclusivity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/keyrot-spike-note.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_keyrot_spike_note_boringtun_multi_queue_limitation", "target": "docs_research_keyrot_spike_note_two_device_mechanism_b", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/keyrot-spike-note.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_keyrot_spike_note_latest_handshakes_not_wallclock", "target": "docs_research_ops_finding_multi_gateway_convergence_last_handshake_false_advance", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/research/keyrot-spike-note.md", "source_location": null, "weight": 1.0}], "hyperedges": []}