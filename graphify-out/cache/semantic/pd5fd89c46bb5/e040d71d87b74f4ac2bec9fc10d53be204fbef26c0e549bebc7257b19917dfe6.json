{"nodes": [{"id": "docs_research_ops_finding_sync_half_open_stream_sync_half_open_stream", "label": "Gateway Sync stream goes silently half-open (no keepalive)", "file_type": "concept", "source_file": "docs/research/ops-finding-sync-half-open-stream.md", "source_location": "crates/wiremesh-gateway/src/sync.rs::connect", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A long-lived Watch stream that receives no pushes is completely silent on the wire, so a dropped conntrack/middlebox entry is undetectable and the blocking Streaming read never returns; the separate observe UDP loop keeps logging, which masks the failure. Policy, PunchDirective and RotateDirective all stop arriving while the gateway believes it is connected."}, {"id": "docs_research_ops_finding_sync_half_open_stream_sync_keepalive_fix", "label": "Canonical Sync keepalive constants (15s/10s + 10s connect timeout)", "file_type": "concept", "source_file": "docs/research/ops-finding-sync-half-open-stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All three crates derive from one canonical constant set extracted to wiremesh-enroll so client and server sides cannot drift apart; keep_alive_while_idle is set because the Watch stream is exactly the idle case."}, {"id": "docs_research_ops_finding_sync_half_open_stream_relay_stale_denylist", "label": "Half-open relay Sync silently enforces a stale revocation denylist", "file_type": "concept", "source_file": "docs/research/ops-finding-sync-half-open-stream.md", "source_location": "wiremesh-relay/src/lib.rs::run_sync", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical bug to the gateway's but with a security failure mode: a certificate revoked after the stream died keeps being accepted until the relay restarts, since the offline-persisted denylist only covers what arrived before."}, {"id": "docs_research_ops_finding_sync_half_open_stream_sync_session_generation", "label": "Sync session generation (per-boot nonce) follow-up", "file_type": "concept", "source_file": "docs/research/ops-finding-sync-half-open-stream.md", "source_location": "Broker::on_report", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_research_ops_finding_sync_half_open_stream_sync_half_open_stream", "target": "docs_research_operator_remote_deployment_notes_finding3_hostname_sync_observe", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/ops-finding-sync-half-open-stream.md", "source_location": "Finding 3", "weight": 1.0}, {"source": "docs_research_ops_finding_sync_half_open_stream_sync_keepalive_fix", "target": "docs_research_ops_finding_sync_half_open_stream_sync_half_open_stream", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/ops-finding-sync-half-open-stream.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_ops_finding_sync_half_open_stream_relay_stale_denylist", "target": "docs_research_ops_finding_sync_half_open_stream_sync_half_open_stream", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/ops-finding-sync-half-open-stream.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_ops_finding_sync_half_open_stream_sync_half_open_stream", "target": "docs_research_ops_finding_sync_half_open_stream_sync_session_generation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/ops-finding-sync-half-open-stream.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_ops_finding_sync_half_open_stream_sync_session_generation", "target": "docs_research_proto_block_design_verification_on_report_stale_snapshot_race", "relation": "references", "